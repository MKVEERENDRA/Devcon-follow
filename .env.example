NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb+srv://<credential-from-your-secret-manager>
MONGODB_DB=devcon_follow
# Optional host-specific guard; rejects credentials with extra/broader roles before indexes initialize.
REQUIRE_SCOPED_DATABASE_USER=
# Off by default. Only for an expressly accepted extra readAnyDatabase role on a dedicated identity.
ALLOW_DATABASE_READ_ANY=false
# Explicit application tier for non-Railway private APK delivery; independent of NODE_ENV.
APP_ENVIRONMENT=
ANDROID_PREVIEW_API_ORIGIN=
# HTTPS web origin to allow browser CORS. Comma-separated if necessary.
WEB_ORIGINS=https://your-frontend.example
# Trusted OIDC provider settings (Auth0, Clerk, etc.); NEVER issue self-declared auth IDs.
OIDC_ISSUER=https://your-oidc-provider.example/
OIDC_AUDIENCE=devcon-follow-api
OIDC_JWKS_URL=https://your-oidc-provider.example/.well-known/jwks.json
# Set with deploy/auth0/verified-email.cjs for Auth0 API access tokens.
OIDC_EMAIL_CLAIM_NAMESPACE=https://devcon-follow.vercel.app/claims
# HTTPS endpoint operated or authorized by Devcon ticket organizers; must bind credential to logged-in identity.
TICKET_VERIFY_URL=
TICKET_VERIFY_TOKEN=
TICKET_BINDING_HMAC_KEY=
# Optional admin OIDC subject IDs, comma-separated
ADMIN_SUBJECTS=
# For MongoDB replica sets or Atlas (transactions used for some atomic operations)
# Set true only when the API can ONLY be reached through a trusted proxy that normalizes forwarded headers
TRUST_PROXY=false

# Public SPA OIDC client id (PKCE authorization-code browser client)
WEB_OIDC_CLIENT_ID=
# Same-origin deployment served by Fastify; allowlist external domains only when needed.
APP_PUBLIC_URL=
# Native BLE/Wi-Fi scanning: enable only after on-device interoperability and safety testing.
PROXIMITY_TOKEN_HMAC_KEY=

# Optional community pilot. Invitations are NOT official ticket verification.
COMMUNITY_ACCESS_ENABLED=false
# New optional basic membership policy; enable only in an approved staging rollout.
# Requires verified OIDC email claims, not a ticket or invitation.
COMMUNITY_SELF_SERVICE_ENABLED=false
# closed (default), pilot (verified-email cohort), public (separate release approval).
COMMUNITY_REGISTRATION_MODE=closed
# Server-only pilot cohort; no ticket/invitation codes. Never return these emails to clients.
COMMUNITY_PILOT_EMAILS=
COMMUNITY_INVITE_HMAC_KEY=
# Separate public OIDC client configured for native PKCE + devconfollow://callback
NATIVE_OIDC_CLIENT_ID=

# Keep the hosted sign-in UI closed while staging acceptance is incomplete.
REGISTRATION_ENABLED=false
# Set only after Google OAuth credentials/connection are approved and configured.
OIDC_GOOGLE_CONNECTION=
# Direct HTTPS Socket.IO origin when web/API use different hosts; never a secret.
SOCKET_PUBLIC_ORIGIN=
# Optional startup egress probe, honored only in Railway staging.
STAGING_EGRESS_DIAGNOSTIC=false

# Optional native push. Off until separately authorized credentials and device tests pass.
# Requires enhanced Expo push security and its server-only access token.
# In-app persisted meeting updates work without external push. No token in browser/mobile bundle.
PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
