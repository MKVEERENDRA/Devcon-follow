{
  "name": "devcon-follow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "build": "npm --prefix web ci --no-audit --no-fund && npm run build:web",
    "build:web": "npm --prefix web run build",
    "test:browser": "node scripts/browser-journey.mjs",
    "preview:staging": "node scripts/staging-preview.mjs",
    "test:browser:reliability": "node scripts/browser-reliability.mjs",
    "test:browser:parity": "node scripts/browser-parity.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "mongodb": "^6.20.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "mongodb-memory-server": "^11.3.0"
  }
}
