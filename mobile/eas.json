{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "developmentClient": false,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://devcon-follow-api-staging.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
